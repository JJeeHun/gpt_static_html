      "nodes": [
        "ip-routing",
        "dns",
        "socket-tcp",
        "http-tls",
        "db-index-mvcc",
        "distributed"
      ]
    },
    {
      "id": "native-kernel",
      "title": "Native · Kernel",
      "goal": "고수준 코드 아래의 메모리·실행 파일·커널 구현까지 내려갑니다.",
      "nodes": [
