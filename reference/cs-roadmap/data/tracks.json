      "nodes": [
        "ip-routing",
        "dns",
        "socket-tcp",
        "http-tls",
        "epoll"
      ]
    },
    {
      "id": "storage-database",
      "title": "Storage · Database",
      "goal": "데이터를 저장하고 빠르게 찾으며 장애 후에도 지키는 원리를 이해합니다.",
      "nodes": [
        "storage-raid",
        "filesystem",
        "page-cache",
        "db-index-mvcc",
        "db-buffer-wal"
