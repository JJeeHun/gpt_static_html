    },
    {
      "type": "table",
      "title": "진단·관리",
      "headers": [
        "작업",
        "명령",
        "설명"
      ],
      "rows": [
        [
          "설정 확인",
          "ssh -G prod",
          "최종 적용 설정"
        ],
        [
          "디버깅",
          "ssh -vvv prod",
          "연결 단계"
        ],
        [
          "키 목록",
          "ssh-add -l",
          "agent 키"
        ],
        [
          "복사",
          "scp file prod:/tmp/",
          "단순 복사"
        ],
        [
          "동기화",
          "rsync -avz dir/ prod:/srv/",
          "증분 복사"
        ]
      ]
