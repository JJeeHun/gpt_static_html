    {
      "type": "code",
      "title": "systemd 진단 흐름",
      "code": "systemctl status myapp\njournalctl -u myapp -n 100 --no-pager\nsudo systemctl daemon-reload\nsudo systemctl restart myapp\nsystemctl status myapp\nss -lntp"
    },
    {
      "type": "code",
      "title": "프로세스 환경변수",
      "code": "P=$(pgrep -f 'my-app' | head -1)\n[ -n \"$P\" ] && tr '\\0' '\\n' < \"/proc/$P/environ\" | sort"
    }
  ]
