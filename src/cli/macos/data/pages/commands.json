{
  "id": "commands",
  "kind": "commands",
  "title": "macOS 핵심 명령 레퍼런스",
  "eyebrow": "Command Reference",
  "description": "처음에는 핵심 명령만 보고, 익숙해진 뒤 자주 쓰는 명령과 확장 명령으로 넓혀갑니다.",
  "blocks": [
    {
      "type": "commands",
      "title": "명령어",
      "intro": "기본값은 핵심 명령만 표시합니다.",
      "items": [
        {
          "command": "pwd",
          "summary": "현재 디렉터리 확인",
          "example": "pwd",
          "priority": "essential"
        },
        {
          "command": "ls -lah",
          "summary": "숨김 파일까지 자세히 보기",
          "example": "ls -lah",
          "priority": "essential"
        },
        {
          "command": "cd",
          "summary": "디렉터리 이동",
          "example": "cd ~/Downloads",
          "priority": "essential"
        },
        {
          "command": "mkdir -p",
          "summary": "중첩 디렉터리 만들기",
          "example": "mkdir -p src/api",
          "priority": "essential"
        },
        {
          "command": "cp",
          "summary": "파일 복사",
          "example": "cp .env .env.backup",
          "priority": "essential"
        },
        {
          "command": "mv",
          "summary": "이동·이름 변경",
          "example": "mv old.txt new.txt",
          "priority": "essential"
        },
        {
          "command": "rm",
          "summary": "파일 삭제",
          "example": "rm temp.txt",
          "priority": "essential"
        },
        {
          "command": "cat / less",
          "summary": "파일 읽기",
          "example": "less server.log",
          "priority": "essential"
        },
        {
          "command": "grep",
          "summary": "텍스트 필터",
          "example": "grep -Rni TODO src",
          "priority": "essential"
        },
        {
          "command": "find",
          "summary": "파일·경로 찾기",
          "example": "find . -name '*.json'",
          "priority": "essential"
        },
        {
          "command": "command -v",
          "summary": "실행 파일 확인",
          "example": "command -v node",
          "priority": "essential"
        },
        {
          "command": "man",
          "summary": "매뉴얼 보기",
          "example": "man ssh",
          "priority": "essential"
        },
        {
          "command": "lsof",
          "summary": "파일·포트 사용 프로세스 확인",
          "example": "lsof -i :3000",
          "priority": "common"
        },
        {
          "command": "pgrep",
          "summary": "프로세스 찾기",
          "example": "pgrep -fl node",
          "priority": "common"
        },
        {
          "command": "ps",
          "summary": "프로세스 상태",
          "example": "ps aux",
          "priority": "common"
        },
        {
          "command": "kill",
          "summary": "프로세스 종료 요청",
          "example": "kill 12345",
          "priority": "common"
        },
        {
          "command": "curl",
          "summary": "HTTP 요청",
          "example": "curl -fsS https://example.com",
          "priority": "common"
        },
        {
          "command": "dig",
          "summary": "DNS 조회",
          "example": "dig +short example.com",
          "priority": "common"
        },
        {
          "command": "nc",
          "summary": "TCP 연결 점검",
          "example": "nc -vz host 443",
          "priority": "common"
        },
        {
          "command": "open",
          "summary": "Finder/앱으로 열기",
          "example": "open .",
          "priority": "common"
        },
        {
          "command": "pbcopy",
          "summary": "클립보드 복사",
          "example": "pwd | pbcopy",
          "priority": "common"
        },
        {
          "command": "brew",
          "summary": "패키지 관리",
          "example": "brew install jq",
          "priority": "common"
        },
        {
          "command": "ssh",
          "summary": "원격 접속",
          "example": "ssh prod",
          "priority": "common"
        },
        {
          "command": "rsync",
          "summary": "증분 동기화",
          "example": "rsync -avz dist/ prod:/srv/app/",
          "priority": "common"
        },
        {
          "command": "awk",
          "summary": "필드 추출·조건 처리",
          "example": "awk '{print $2}'",
          "priority": "advanced"
        },
        {
          "command": "sed",
          "summary": "패턴 치환",
          "example": "sed -i '' 's/a/b/' file",
          "priority": "advanced"
        },
        {
          "command": "xargs",
          "summary": "stdin을 argument로 변환",
          "example": "printf '%s\\n' a b | xargs echo",
          "priority": "advanced"
        },
        {
          "command": "scutil",
          "summary": "DNS·시스템 설정 확인",
          "example": "scutil --dns",
          "priority": "advanced"
        },
        {
          "command": "diskutil",
          "summary": "디스크 관리",
          "example": "diskutil list",
          "priority": "advanced"
        },
        {
          "command": "launchctl",
          "summary": "launchd 서비스 제어",
          "example": "launchctl list",
          "priority": "advanced"
        }
      ]
    }
  ]
}